@top rules { rule* }

rule {
  Head "->" productions "." |
  Head ":" productions ";"
}

Head { Symbol | QuotedSymbol }

productions { Production ("|" Production)* }

Production { term* }

term { Symbol | QuotedSymbol | Group | Optional | Repeat0 | Repeat1 }

Group { "(" productions ")" }

Optional { term "?" }

Repeat0 { term "*" }

Repeat1 { term "+" }

@skip { space | comment }

@tokens {
  symbolStart { @asciiLetter | "_" | "$" }
  symbolPart { symbolStart | @digit }
  Symbol { symbolStart symbolPart* }
  
  QuotedSymbol {
    '"' (![\\\n"] | "\\" _)* '"' |
    "'" (![\\\n'] | "\\" _)* "'"
  }
  
  space { @whitespace+ }
  comment { "#" ![\n]* }
}
