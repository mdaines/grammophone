{
  "private": true,
  "version": "0.0.0",
  "name": "grammophone",
  "type": "module",
  "source": [
    "src/index.html"
  ],
  "dependencies": {
    "@lezer/lr": "^1.3.3",
    "@viz-js/viz": "^3.2.0",
    "i18next": "^26.0.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.1",
    "utf8": "^3.0.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.2.2",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "mocha": "^11.7.5",
    "parcel": "^2.8.3",
    "prettier": "^3.8.1"
  },
  "scripts": {
    "generate-lezer-parser": "lezer-generator --output src/parser/rules.js src/parser/rules.grammar",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md,html}\" \"test/**/*.{js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md,html}\" \"test/**/*.{js,jsx,json}\"",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "test": "mocha --recursive --extension \".test.js\"",
    "build": "yarn run format && yarn run lint && yarn run test && parcel build --no-autoinstall --no-cache",
    "serve": "parcel serve --no-autoinstall --no-cache"
  },
  "alias": {
    "process": false
  }
}
